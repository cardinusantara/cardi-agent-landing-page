---
// ScrollFlowSection.astro
---
<section class="flow-section" id="ekosistem">
  <div class="wrap center" style="margin-bottom: 50px;">
    <div class="eyebrow">EKOSISTEM BISNIS TERPADU</div>
    <h2 class="h2">Satu ekosistem, banyak solusi.</h2>
    <p class="sub">Metodologi pertumbuhan 4 tahap terintegrasi yang dirancang untuk membawa bisnis Anda dari fondasi terawal hingga siap melantai di bursa saham (IPO).</p>
  </div>

  <div class="wrap flow-wrap">
    <!-- Left Sticky Side -->
    <div class="flow-sticky-side" id="flow-sticky-container" data-stage="0">
      <div class="flow-sticky-content">
        <div class="stage-tracker">
          <span class="stage-num" id="stage-number">01</span>
          <span class="stage-total">/ 04</span>
        </div>

        <div class="circle-canvas">
          <svg width="150" height="150" viewBox="0 0 120 120" fill="none">
            <path id="morphing-leaf" d="M60 62 C46 46 47 22 60 14 C73 22 74 46 60 62 Z" class="morphing-leaf" />
            <circle id="morphing-dot" cx="60" cy="60" r="8" class="morphing-dot" />
          </svg>
        </div>

        <div class="stage-caption">
          <span class="stage-eyebrow" id="stage-eyebrow">STAGE 01 · BUILD</span>
          <h4 class="stage-title" id="stage-title">Build the Brand</h4>
        </div>
      </div>
    </div>

    <!-- Right Scroll Side -->
    <div class="flow-scroll-side">
      <!-- Step 1: Build the Brand (Branding) -->
      <div class="flow-card active" data-stage-index="0">
        <div class="flow-card-inner">
          <div class="flow-card-header">
            <span class="flow-tag" style="background:#FFF0EE;color:#FF3B30">STEP 01 · BRAND DEVELOPMENT</span>
            <h3>Build the Brand</h3>
            <small>Cardi Branding</small>
          </div>
          <p>Membangun identitas brand yang kuat, relevan, dan berdaya saing tinggi. Kami merancang desain visual, strategi positioning, dan narasi brand yang memikat calon pelanggan sejak impresi pertama.</p>
          <ul class="flow-pillars">
            <li>Brand Strategy &amp; Positioning</li>
            <li>Visual Identity System &amp; Logo Design</li>
            <li>Packaging &amp; Marketing Collaterals</li>
          </ul>
          <div class="flow-card-footer">
            <a href="https://branding.cardinusantara.com/" target="_blank" class="btn wa" style="background:#FF3B30">Kunjungi website</a>
          </div>
        </div>
      </div>

      <!-- Step 2: Launch the Brand (Nusantara) -->
      <div class="flow-card" data-stage-index="1">
        <div class="flow-card-inner">
          <div class="flow-card-header">
            <span class="flow-tag" style="background:#F0F2F6;color:#0A1633">STEP 02 · GTM &amp; DISTRIBUTION</span>
            <h3>Launch the Brand</h3>
            <small>Cardi Nusantara</small>
          </div>
          <p>Membawa brand Anda masuk ke pasar nasional dengan jalur distribusi yang terstruktur. Kami membantu eksekusi Go-To-Market (GTM) dan penetrasi jaringan retail secara efektif.</p>
          <ul class="flow-pillars">
            <li>Go-To-Market (GTM) Strategy</li>
            <li>National Retail Distribution Network</li>
            <li>Trade Marketing &amp; Field Execution</li>
          </ul>
          <div class="flow-card-footer">
            <a href="https://cardinusantara.com/" target="_blank" class="btn wa" style="background:#0A1633">Kunjungi website</a>
          </div>
        </div>
      </div>

      <!-- Step 3: Grow the Brand (Digital) -->
      <div class="flow-card" data-stage-index="2">
        <div class="flow-card-inner">
          <div class="flow-card-header">
            <span class="flow-tag" style="background:#FCEAEA;color:#C61A09">STEP 03 · DIGITAL GROWTH</span>
            <h3>Grow the Brand</h3>
            <small>Cardi Digital</small>
          </div>
          <p>Akselerasi skala pertumbuhan bisnis melalui strategi digital terukur. Kami mengelola performa marketing, optimasi konversi, dan kampanye media sosial untuk melipatgandakan omzet.</p>
          <ul class="flow-pillars">
            <li>Performance Marketing &amp; Paid Ads</li>
            <li>Social Media &amp; Content Ecosystem</li>
            <li>Conversion Rate Optimization (CRO)</li>
          </ul>
          <div class="flow-card-footer">
            <a href="https://digital.cardinusantara.com/" target="_blank" class="btn wa" style="background:#C61A09">Kunjungi website</a>
          </div>
        </div>
      </div>

      <!-- Step 4: Scale to IPO (Cardi AI Agent) -->
      <div class="flow-card" data-stage-index="3">
        <div class="flow-card-inner">
          <div class="flow-card-header">
            <span class="flow-tag" style="background:#EEF3FF;color:#1E4FFF">STEP 04 · OPERATIONAL SCALE &amp; IPO READINESS</span>
            <h3>Scale to IPO</h3>
            <small>Cardi AI Agent</small>
          </div>
          <p>AI Agents for Business Growth &amp; IPO Readiness. Mengotomatisasi konversi penjualan 24/7 autopilot, menstandarisasi pelaporan data operasional secara transparan, serta merapikan pembukuan transaksi digital agar siap memenuhi standar audit IPO.</p>
          <div class="flow-card-footer">
            <a href="/agent" class="btn wa" style="background:#1E4FFF">Pelajari Cardi AI Agent</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const flowCards = document.querySelectorAll('.flow-card');
    const stickyContainer = document.getElementById('flow-sticky-container');
    const stageNumEl = document.getElementById('stage-number');
    const stageEyebrowEl = document.getElementById('stage-eyebrow');
    const stageTitleEl = document.getElementById('stage-title');

    const stageMetadata = [
      { num: "01", eyebrow: "STAGE 01 · BUILD", title: "Build the Brand" },
      { num: "02", eyebrow: "STAGE 02 · LAUNCH", title: "Launch the Brand" },
      { num: "03", eyebrow: "STAGE 03 · GROW", title: "Grow the Brand" },
      { num: "04", eyebrow: "STAGE 04 · IPO READINESS", title: "Scale to IPO" }
    ];

    function updateActiveStage() {
      const viewportCenter = window.innerHeight / 2;
      let activeIndex = 0;
      let minDistance = Infinity;

      flowCards.forEach((card, idx) => {
        const rect = card.getBoundingClientRect();
        const cardCenter = rect.top + rect.height / 2;
        const distance = Math.abs(cardCenter - viewportCenter);

        if (distance < minDistance) {
          minDistance = distance;
          activeIndex = idx;
        }
      });

      flowCards.forEach((card, idx) => {
        if (idx === activeIndex) {
          card.classList.add('active');
        } else {
          card.classList.remove('active');
        }
      });

      if (stickyContainer) {
        stickyContainer.setAttribute('data-stage', activeIndex.toString());
      }

      const meta = stageMetadata[activeIndex];
      if (stageNumEl && stageEyebrowEl && stageTitleEl && meta) {
        stageNumEl.textContent = meta.num;
        stageEyebrowEl.textContent = meta.eyebrow;
        stageTitleEl.textContent = meta.title;
      }
    }

    window.addEventListener('scroll', updateActiveStage, { passive: true });
    window.addEventListener('resize', updateActiveStage, { passive: true });
    updateActiveStage();
  });
</script>
