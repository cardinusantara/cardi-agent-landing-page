---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import type { LangKey } from '../i18n/ui';

interface Props {
  lang?: LangKey;
}

const { lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
---

<div class="hero-story" id="heroStory">
  <!-- Logo + "cardi" wordmark are already fully formed at rest — no
       assembly-from-nothing on load. Scrolling collapses them apart (petals
       fly outward, spinning) and reveals the navbar, then the headline. -->
  <div class="hero-intro" id="heroIntro">
    <div class="hero-intro-track" id="heroIntroTrack">
      <div class="hero-intro-stage">
        <div class="hero-intro-frame">

          <div class="hero-intro-logo-group" id="heroIntroLogoGroup" aria-hidden="true">
            <div class="hero-intro-logo" id="heroIntroLogo">
              <div class="hero-intro-glow"></div>
              <svg class="hero-intro-svg" viewBox="0 0 120 120" fill="none">
                <path class="hero-intro-petal" d="M60 62 C46 46 47 22 60 14 C73 22 74 46 60 62 Z" />
                <path class="hero-intro-petal" d="M60 62 C46 46 47 22 60 14 C73 22 74 46 60 62 Z" />
                <path class="hero-intro-petal" d="M60 62 C46 46 47 22 60 14 C73 22 74 46 60 62 Z" />
                <path class="hero-intro-petal" d="M60 62 C46 46 47 22 60 14 C73 22 74 46 60 62 Z" />
                <path class="hero-intro-petal" d="M60 62 C46 46 47 22 60 14 C73 22 74 46 60 62 Z" />
                <path class="hero-intro-petal" d="M60 62 C46 46 47 22 60 14 C73 22 74 46 60 62 Z" />
              </svg>
            </div>
            <div class="hero-intro-wordmark" id="heroIntroWordmark">cardi</div>
          </div>

          <div class="hero-intro-copy" id="heroIntroCopy">
            <h1 class="hero-story-title" id="heroIntroTitle">{t('hero.title')}</h1>
            <p class="hero-story-body" id="heroIntroBody">{t('hero.body')}</p>
            <div class="heroCta hero-story-cta" id="heroIntroCta">
              <a class="btn" href="https://api.whatsapp.com/send?phone=6281289895646&text=Hello%20Cardi!!%20I%20would%20like%20to%20consult%20about%20the%20business%20ecosystem.%20%F0%9F%98%81%F0%9F%98%81" target="_blank">{t('hero.ctaConsult')}</a>
              <a class="btn ghost" href="#produk">{t('hero.ctaExplore')}</a>
            </div>
          </div>

        </div>

        <div class="hero-intro-scrollcue" id="heroIntroCue" aria-hidden="true">
          <span></span>
        </div>
      </div>
    </div>
  </div>
</div>

<noscript>
  <style>
    /* Without JS the scroll-progress animation never runs — force the
       settled end state instead of leaving text/CTA permanently hidden. */
    .hero-intro-track { height: auto !important; }
    .hero-intro-stage {
      position: relative !important;
      top: 0 !important;
      height: auto !important;
      min-height: 0 !important;
      padding: 48px 24px !important;
    }
    .hero-intro-logo-group { display: none !important; }
    .hero-intro-copy { opacity: 1 !important; transform: none !important; pointer-events: auto !important; }
    .hero-intro-scrollcue { display: none !important; }
  </style>
</noscript>

<script>
  function easeOutCubic(x: number) {
    return 1 - Math.pow(1 - x, 3);
  }
  function easeInCubic(x: number) {
    return x * x * x;
  }
  function clamp01(x: number) {
    return Math.min(1, Math.max(0, x));
  }
  function lerp(a: number, b: number, t: number) {
    return a + (b - a) * t;
  }

  document.addEventListener('DOMContentLoaded', initHeroIntro);

  function initHeroIntro() {
    const track = document.getElementById('heroIntroTrack');
    const logoGroup = document.getElementById('heroIntroLogoGroup');
    const logoEl = document.getElementById('heroIntroLogo');
    const wordmarkEl = document.getElementById('heroIntroWordmark');
    const titleEl = document.getElementById('heroIntroTitle');
    const bodyEl = document.getElementById('heroIntroBody');
    const ctaEl = document.getElementById('heroIntroCta');
    const copyEl = document.getElementById('heroIntroCopy');
    const cueEl = document.getElementById('heroIntroCue');
    const introRoot = document.getElementById('heroIntro');
    const petals = introRoot
      ? (Array.from(introRoot.querySelectorAll('.hero-intro-petal')) as HTMLElement[])
      : [];

    if (!track || !logoGroup || !logoEl || !wordmarkEl || !titleEl || !bodyEl || !ctaEl || !copyEl || !introRoot || petals.length === 0) return;

    // The head script in Layout.astro already decided (reduced-motion) whether
    // the intro should run at all — its decision is the single source of
    // truth via the intro-pending class.
    const introPending = document.documentElement.classList.contains('intro-pending');
    if (!introPending) {
      introRoot.classList.add('is-settled');
      return;
    }

    // Each petal flies outward and over-rotates as the mark collapses —
    // reverse of an assembly, same throw distances either way.
    const petalConfig = [
      { angle: 0, dx: -200, dy: -55, rot: -100, scale: 0.25 },
      { angle: 60, dx: 175, dy: -150, rot: 95, scale: 0.25 },
      { angle: 120, dx: 220, dy: 85, rot: -90, scale: 0.25 },
      { angle: 180, dx: -65, dy: 210, rot: 100, scale: 0.25 },
      { angle: 240, dx: -220, dy: 50, rot: -95, scale: 0.25 },
      { angle: 300, dx: 85, dy: -210, rot: 90, scale: 0.25 },
    ];

    const rawLines = (titleEl.textContent || '')
      .split('\n')
      .map((s) => s.trim())
      .filter(Boolean);
    titleEl.innerHTML = rawLines
      .map((line) => `<span class="line-mask"><span class="line-inner">${line}</span></span>`)
      .join('');
    const lineEls = Array.from(titleEl.querySelectorAll<HTMLElement>('.line-inner'));
    const lineMaskEls = Array.from(titleEl.querySelectorAll<HTMLElement>('.line-mask'));

    let navRevealed = false;
    function revealNav() {
      if (navRevealed) return;
      navRevealed = true;
      document.documentElement.classList.remove('intro-pending');
      document.dispatchEvent(new CustomEvent('cardi:introDone'));
    }

    let ticking = false;

    function render() {
      ticking = false;
      const rect = track!.getBoundingClientRect();
      const total = track!.offsetHeight - window.innerHeight;
      const p = total > 0 ? clamp01(-rect.top / total) : rect.top < 0 ? 1 : 0;

      // COLLAPSE [0, .32]: the fully-formed mark breaks apart and spins away.
      const collapseP = clamp01(p / 0.32);
      petals.forEach((el, i) => {
        const cfg = petalConfig[i];
        const start = i * 0.05;
        const dur = 0.6;
        const lp = easeInCubic(clamp01((collapseP - start) / dur));
        const dx = lerp(0, cfg.dx, lp);
        const dy = lerp(0, cfg.dy, lp);
        const rot = lerp(0, cfg.rot, lp);
        const scale = lerp(1, cfg.scale, lp);
        el.style.opacity = String(1 - lp);
        el.style.transform = `rotate(${cfg.angle}deg) translate(${dx}px, ${dy}px) rotate(${rot}deg) scale(${scale})`;
      });
      const spinDeg = lerp(0, 380, easeInCubic(collapseP));
      logoEl!.style.transform = `rotate(${spinDeg}deg)`;

      const wmP = easeInCubic(collapseP);
      wordmarkEl!.style.opacity = String(1 - wmP);
      wordmarkEl!.style.transform = `translateY(${lerp(0, -20, wmP)}px)`;
      wordmarkEl!.style.letterSpacing = `${lerp(-0.02, 0.5, wmP)}em`;

      if (collapseP >= 1 && !navRevealed) revealNav();

      // TITLE lines, staggered, overlapping the tail of the collapse.
      const lineStart = 0.28;
      const lineStagger = 0.08;
      const lineDur = 0.22;
      lineEls.forEach((el, i) => {
        const s = lineStart + i * lineStagger;
        const lp = easeOutCubic(clamp01((p - s) / lineDur));
        el.style.transform = `translateY(${lerp(100, 0, lp)}%)`;
        lineMaskEls[i].style.opacity = lp > 0 ? '1' : '0';
      });

      const bodyLp = easeOutCubic(clamp01((p - 0.62) / 0.16));
      bodyEl!.style.opacity = String(bodyLp);
      bodyEl!.style.transform = `translateY(${lerp(16, 0, bodyLp)}px)`;

      const ctaLp = easeOutCubic(clamp01((p - 0.72) / 0.18));
      ctaEl!.style.opacity = String(ctaLp);
      ctaEl!.style.transform = `translateY(${lerp(16, 0, ctaLp)}px)`;

      copyEl!.style.pointerEvents = p > 0.26 ? 'auto' : 'none';

      if (cueEl) cueEl.style.opacity = String(1 - clamp01(p / 0.06));
    }

    function onScrollOrResize() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(render);
      }
    }

    window.addEventListener('scroll', onScrollOrResize, { passive: true });
    window.addEventListener('resize', onScrollOrResize);
    render();
  }
</script>
