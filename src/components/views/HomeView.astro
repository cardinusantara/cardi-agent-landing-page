---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../Navbar.astro';
import Footer from '../Footer.astro';
import ScrollFlowSection from '../ScrollFlowSection.astro';
import ConsultModal from '../ConsultModal.astro';
import PurchaseNotif from '../PurchaseNotif.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import type { LangKey } from '../../i18n/ui';

interface Props {
  lang?: LangKey;
}

const { lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout title={t('seo.homeTitle')} description={t('seo.homeDesc')} lang={lang}>
  <!-- NAV -->
  <Navbar lang={lang} />

  <!-- HERO -->
  <div class="hero">
    <div class="wrap">
      <div class="hero-copy">
        <p class="hero-eyebrow">{t('hero.eyebrow')}</p>
        <div class="hero-rule" aria-hidden="true"></div>
        <h1 class="hero-lead">{t('hero.lead')}</h1>
        <p class="hero-body">{t('hero.body')}</p>
        <div class="heroCta">
          <a class="btn" href="https://api.whatsapp.com/send?phone=6281289895646&text=Hello%20Cardi!!%20I%20would%20like%20to%20consult%20about%20the%20business%20ecosystem.%20%F0%9F%98%81%F0%9F%98%81" target="_blank">{t('hero.ctaConsult')}</a>
          <a class="btn ghost" href="#produk">{t('hero.ctaExplore')}</a>
        </div>
      </div>

      <!-- Hero visual -->
      <div class="hero-visual">
        <div class="hero-visual-glow" aria-hidden="true"></div>
        <figure class="hero-visual-frame">
          <img
            src="/hero_ipo.png"
            alt="Cardi — Business Growth Ecosystem. Strategic. Trusted. Together to IPO."
            width="1600"
            height="800"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </figure>
      </div>
    </div>
  </div>

  <!-- TRUST -->
  <div class="trust">
    <div class="wrap">
      <div class="t">Dipercaya 19+ brand &amp; bisnis di Indonesia</div>
      <div class="logos">
        <span>MAMAKOKO</span><span>URBAN MILLS</span><span>LATEZZA</span><span>REPUBLIC PADEL</span><span>SURYA
          PAINTING</span><span>ANW KLINIK</span><span>NIHON MART</span>
      </div>
    </div>
  </div>

  <!-- PRODUK (SCROLL FLOW) -->
  <ScrollFlowSection lang={lang} />

  <!-- SOLUSI -->
  <section class="solusi" id="solusi">
    <div class="wrap">
      <div class="center">
        <div class="eyebrow">{t('nav.solutions')}</div>
        <h2 class="h2">{t('sol.title')}</h2>
        <p class="sub">{t('sol.sub')}</p>
      </div>
      <div class="solGrid">
        <div class="scard">
          <div class="ic" style="background:#E7EDFF"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"
              stroke="#0258a4" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6" />
            </svg></div>
          <h3>{t('sol.c1Title')}</h3>
          <p>{t('sol.c1Desc')}</p>
        </div>
        <div class="scard">
          <div class="ic" style="background:#E3F6EF"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"
              stroke="#00A87E" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 17l6-6 4 4 8-8M21 7v6h-6" />
            </svg></div>
          <h3>{t('sol.c2Title')}</h3>
          <p>{t('sol.c2Desc')}</p>
        </div>
        <div class="scard">
          <div class="ic" style="background:#F1E7FF"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"
              stroke="#8B3DFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7" rx="1.5" />
              <rect x="14" y="3" width="7" height="7" rx="1.5" />
              <rect x="3" y="14" width="7" height="7" rx="1.5" />
              <rect x="14" y="14" width="7" height="7" rx="1.5" />
            </svg></div>
          <h3>{t('sol.c3Title')}</h3>
          <p>{t('sol.c3Desc')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="stats">
    <div class="wrap statGrid">
      <div class="stat"><b>10<em>+</em></b><span>tahun pengalaman branding &amp; digital</span></div>
      <div class="stat"><b>19<em>+</em></b><span>klien aktif lintas industri</span></div>
      <div class="stat"><b>37</b><span>talenta dalam satu tim eksekusi</span></div>
      <div class="stat"><b>24<em>/7</em></b><span>AI bekerja tanpa henti</span></div>
    </div>
  </section>

  <!-- HARGA -->
