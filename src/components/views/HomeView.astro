    <div class="wrap">
      <div class="center">
        <div class="eyebrow">{t('pri.tag')}</div>
        <h2 class="h2">{t('pri.title')}</h2>
        <p class="sub">{t('pri.sub')}</p>
      </div>

      <div class="marquee-wrapper" style="margin-top: 40px;">
        <div class="marquee-track">
          <!-- SET 1 (4 CARDS) -->
          <!-- CARD 1: Cardi AI Agent -->
          <div class="marquee-card">
            <div class="pcard" style="border-color: #D3DEF5; box-shadow: 0 12px 30px -10px rgba(30,79,255,.08);">
              <div class="lock">
                <svg width="42" height="42" viewBox="0 0 120 120" fill="none">
                  <path d="M60 62 C46 46 47 22 60 14 C73 22 74 46 60 62 Z" fill="#1e4fff"
                    transform="translate(66 60) rotate(90) scale(1.3) translate(-60 -38)" />
                  <circle cx="26" cy="60" r="8" fill="#1e4fff" />
                </svg>
                <div class="tx"><small>cardi</small><b>ai agent</b></div>
              </div>
              <h3 style="margin-top: 10px;">Cardi AI Agent</h3>
              <p>{t('eco.s4Desc')}</p>
              <div style="margin: 18px 0 8px;">
                <small style="display:block; font-size:11.5px; font-weight:700; color:var(--muted)">{t('pri.startFrom')}</small>
                <span style="font-size:32px; font-weight:800; color:var(--ink)">Rp 299.000</span>
                <span style="font-size:14px; color:var(--muted); font-weight:600">{t('pri.perMonth')}</span>
              </div>
              <a class="btn" href={translatePath('/agent')} style="justify-content:center;">{t('pri.viewDetail')}</a>
            </div>
          </div>

          <!-- CARD 2: Cardi Nusantara -->
          <div class="marquee-card">
            <div class="pcard" style="border-color: #D0D4DC; box-shadow: 0 12px 30px -10px rgba(10,22,51,.08);">
              <div class="lock">
                <svg width="42" height="42" viewBox="0 0 120 120" fill="none">
                  <path d="M60 62 C46 46 47 22 60 14 C73 22 74 46 60 62 Z" fill="#0A1633"
                    transform="translate(60 60) rotate(45) scale(1.3) translate(-60 -38)" />
