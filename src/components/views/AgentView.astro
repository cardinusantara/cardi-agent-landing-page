---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../Navbar.astro';
import Footer from '../Footer.astro';
import ConsultModal from '../ConsultModal.astro';
import PurchaseNotif from '../PurchaseNotif.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import type { LangKey } from '../../i18n/ui';

interface Props {
  lang?: LangKey;
}

const { lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout title={t('seo.agentTitle')} description={t('seo.agentDesc')} lang={lang}>
  <Navbar lang={lang} />

  <!-- AGENT STYLES (is:global required for dynamically created chat bubbles & buttons) -->
  <style is:global>
    :root {
      --bg-light: #FAFCFF;
      --bg-gray: #F4F6FB;
      --text-dark: #0F172A;
      --text-gray: #475569;
      --border: #E2E8F0;
      --primary: #1e4fff;
      --blue: #1e4fff;
      --blue-d: #153dcc;
      --accent: #F43F5E;
    }
    .hero {
      padding: 80px 0 60px;
      text-align: left;
      background: radial-gradient(800px 400px at 20% 0%, rgba(30,79,255,0.06), transparent 70%);
    }
    .hero-wrap {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      align-items: center;
    }
    @media(max-width: 900px) {
      .hero-wrap {
        grid-template-columns: 1fr;
      }
    }
    .hero-content h1 {
      font-size: clamp(32px, 4vw, 52px);
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -1.5px;
      color: var(--text-dark);
      margin-bottom: 20px;
    }
    .hero-content p {
      font-size: 17px;
      color: var(--text-gray);
      line-height: 1.65;
      margin-bottom: 32px;
    }
    .simulator-scenarios {
      display: flex;
      gap: 10px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }
    .scenario-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      border-radius: 99px;
      border: 1px solid var(--border);
      background: #fff;
      font-size: 13px;
      font-weight: 700;
      color: var(--text-gray);
      cursor: pointer;
      transition: 0.2s;
    }
    .scenario-btn.active, .scenario-btn:hover {
      border-color: var(--primary);
      color: var(--primary);
      background: #EEF3FF;
    }
    .ui-mockup-container {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 24px;
      box-shadow: 0 20px 40px -15px rgba(15,23,42,0.1);
      overflow: hidden;
    }
    .chat-header {
      padding: 14px 20px;
      background: var(--bg-gray);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .chat-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--primary);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }
    .chat-name {
      font-weight: 800;
      font-size: 14px;
      color: var(--text-dark);
    }
    .chat-status {
      font-size: 11px;
      color: #10B981;
      font-weight: 600;
    }
    .chat-body {
      padding: 20px;
      height: 320px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 12px;
      background: #FAFCFF;
      scroll-behavior: smooth;
    }
    .chat-bubble {
      max-width: 80%;
      padding: 10px 14px;
      border-radius: 14px;
      font-size: 13px;
      line-height: 1.5;
      word-break: break-word;
      animation: fadeIn 0.25s ease-out;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .chat-bubble.in {
      background: #fff;
      border: 1px solid var(--border);
      align-self: flex-start;
      border-bottom-left-radius: 4px;
      color: var(--text-dark);
    }
    .chat-bubble.out {
      background: var(--primary);
      color: #fff;
      align-self: flex-end;
      border-bottom-right-radius: 4px;
    }
    .typing-dots {
      display: inline-flex;
      gap: 4px;
      align-items: center;
    }
    .typing-dots span {
      width: 6px;
      height: 6px;
      background: var(--text-gray);
      border-radius: 50%;
      animation: bounce 1.2s infinite ease-in-out;
    }
    .typing-dots span:nth-child(2) { animation-delay: 0.2s; }
    .typing-dots span:nth-child(3) { animation-delay: 0.4s; }
    @keyframes bounce {
      0%, 80%, 100% { transform: translateY(0); }
      40% { transform: translateY(-6px); }
    }
    .quick-replies {
      padding: 10px 20px;
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      background: #fff;
      border-top: 1px solid var(--border);
    }
    .quick-btn {
      padding: 6px 12px;
      border-radius: 99px;
      border: 1px solid var(--border);
      background: var(--bg-gray);
      font-size: 12px;
      font-weight: 600;
      color: var(--text-dark);
      cursor: pointer;
      transition: 0.2s;
    }
    .quick-btn:hover {
      border-color: var(--primary);
      color: var(--primary);
    }
    .chat-footer {
      padding: 12px 20px;
      background: #fff;
      border-top: 1px solid var(--border);
    }
    .chat-footer form {
      display: flex;
      gap: 8px;
    }
    .chat-footer input {
      flex: 1;
      padding: 10px 14px;
      border-radius: 10px;
      border: 1px solid var(--border);
      outline: none;
      font-size: 13px;
    }
    .chat-footer button {
      padding: 10px 16px;
      border-radius: 10px;
      background: var(--primary);
      color: #fff;
      border: none;
      cursor: pointer;
      font-weight: 700;
    }
    .compare-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin-top: 40px;
    }
    @media(max-width: 768px) {
      .compare-grid { grid-template-columns: 1fr; }
    }
    .compare-card {
      padding: 32px;
      border-radius: 20px;
      border: 1px solid var(--border);
      background: #fff;
    }
    .compare-card.bad { border-color: #FCA5A5; background: #FFF5F5; }
    .compare-card.good { border-color: #93C5FD; background: #F0F7FF; }
    .compare-header {
      font-size: 18px;
      font-weight: 800;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .compare-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .compare-list li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 14px;
      color: var(--text-dark);
      line-height: 1.5;
    }
    .compare-icon {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      font-weight: 800;
      flex-shrink: 0;
    }
    .icon-x { background: #EF4444; color: #fff; }
    .icon-v { background: #10B981; color: #fff; }

    /* Bento Features */
    .bento-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-top: 40px;
    }
    @media(max-width: 900px) {
      .bento-grid { grid-template-columns: 1fr; }
    }
    .bento-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 28px;
      transition: 0.25s;
    }
    .bento-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 32px -12px rgba(15,23,42,0.1);
    }
    .bento-large { grid-column: span 2; }
    @media(max-width: 900px) { .bento-large { grid-column: span 1; } }
    .bento-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: #EEF3FF;
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
    }
    .bento-card h3 {
      font-size: 18px;
      font-weight: 800;
      margin-bottom: 10px;
      color: var(--text-dark);
    }
    .bento-card p {
      font-size: 14px;
      color: var(--text-gray);
      line-height: 1.6;
    }

    /* ROI Calc */
    .roi-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      align-items: center;
    }
    @media(max-width: 900px) { .roi-grid { grid-template-columns: 1fr; } }
    .roi-calculator {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 36px;
    }
    .roi-slider-group {
      margin-bottom: 32px;
    }
    .roi-slider-group label {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-weight: 700;
      font-size: 14px;
      margin-bottom: 12px;
    }
    .roi-val-badge {
      background: #EEF3FF;
      color: var(--primary);
      padding: 4px 12px;
      border-radius: 99px;
      font-size: 12px;
    }
    .roi-slider-group input[type="range"] {
      width: 100%;
      accent-color: var(--primary);
    }
    .roi-result-card {
      background: var(--bg-gray);
      padding: 16px;
      border-radius: 12px;
    }
    .roi-result-label {
      font-size: 12px;
      font-weight: 700;
      color: var(--text-gray);
      margin-bottom: 4px;
    }
    .roi-result-value {
      font-size: 24px;
      font-weight: 800;
      color: var(--text-dark);
    }
    .roi-result-value.blue { color: var(--primary); }

    .roi-chart-board {
      background: var(--text-dark);
      color: #fff;
      border-radius: 20px;
      padding: 36px;
    }
    .chart-header h4 { font-size: 18px; font-weight: 800; margin-bottom: 6px; }
    .chart-header p { font-size: 13px; color: #94A3B8; margin-bottom: 24px; }
    .chart-bar-group { margin-bottom: 20px; }
    .chart-label { display: flex; justify-content: space-between; font-size: 13px; font-weight: 700; margin-bottom: 8px; }
    .bar-track { height: 12px; background: rgba(255,255,255,0.1); border-radius: 99px; overflow: hidden; }
    .bar-fill { height: 100%; border-radius: 99px; transition: width 0.3s ease; }
    .bar-fill.bad { background: #EF4444; }
    .bar-fill.good { background: #10B981; width: 100%; }
    .chart-summary {
      margin-top: 24px;
      padding-top: 16px;
      border-top: 1px solid rgba(255,255,255,0.1);
      display: flex;
      gap: 12px;
      font-size: 12.5px;
      color: #CBD5E1;
      line-height: 1.5;
    }

    /* Pricing Section */
    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-top: 44px;
    }
    @media(max-width: 900px) { .pricing-grid { grid-template-columns: 1fr; } }
    .pricing-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 36px 28px;
      display: flex;
      flex-direction: column;
    }
    .pricing-card.premium {
      border-color: var(--primary);
      box-shadow: 0 16px 40px -10px rgba(30,79,255,0.15);
      position: relative;
    }
    .pricing-tier { font-size: 13px; font-weight: 800; letter-spacing: 1px; color: var(--primary); text-transform: uppercase; margin-bottom: 12px; }
    .pricing-price { font-size: 38px; font-weight: 800; color: var(--text-dark); margin-bottom: 12px; display: flex; align-items: baseline; gap: 4px; }
    .pricing-desc { font-size: 14px; color: var(--text-gray); line-height: 1.6; margin-bottom: 24px; }
    .pricing-features-list { list-style: none; display: flex; flex-direction: column; gap: 12px; margin-bottom: 32px; flex: 1; }
    .pricing-features-list li { display: flex; align-items: center; gap: 10px; font-size: 13.5px; color: var(--text-dark); }
    .pricing-btn { width: 100%; justify-content: center; text-align: center; }

    /* Roadmap Section (Phase 04-06) */
    .roadmap-section {
      background: var(--bg-gray);
    }
    .roadmap-list {
      margin-top: 44px;
      display: flex;
      flex-direction: column;
      gap: 24px;
    }
    .roadmap-phase {
      position: relative;
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 40px;
      align-items: stretch;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 40px;
      overflow: hidden;
    }
    @media(max-width: 860px) {
      .roadmap-phase {
        grid-template-columns: 1fr;
        gap: 28px;
        padding: 28px;
      }
    }
    .roadmap-ghost-num {
      position: absolute;
      top: -14px;
      right: 8px;
      font-size: clamp(70px, 10vw, 140px);
      font-weight: 800;
      line-height: 1;
      pointer-events: none;
      user-select: none;
      z-index: 0;
    }
    .roadmap-phase-copy {
      position: relative;
      z-index: 1;
    }
    .roadmap-phase-tag {
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 12px;
      display: block;
    }
    .roadmap-phase-copy h3 {
      font-size: clamp(22px, 3vw, 30px);
      font-weight: 800;
      color: var(--text-dark);
      letter-spacing: -0.02em;
      margin-bottom: 16px;
    }
    .roadmap-phase-badge {
      display: inline-block;
      padding: 7px 16px;
      border-radius: 999px;
      font-size: 12.5px;
      font-weight: 700;
      margin-bottom: 26px;
    }
    .roadmap-what-label {
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: var(--text-gray);
      margin-bottom: 16px;
    }
    .roadmap-items {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .roadmap-items li {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 15px;
      font-weight: 700;
      color: var(--text-dark);
    }
    .roadmap-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .roadmap-lead-card {
      position: relative;
      z-index: 1;
      background: var(--bg-gray);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 28px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .roadmap-lead-label {
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: var(--text-gray);
      margin-bottom: 14px;
    }
    .roadmap-lead-card p {
      font-size: 14.5px;
      color: var(--text-dark);
      line-height: 1.7;
    }
    .roadmap-cta {
      text-align: center;
      margin-top: 48px;
    }
  </style>

  <!-- HERO SECTION -->
  <section class="hero" data-lang={lang}>
    <div class="wrap">
      <div class="hero-wrap">
        <div class="hero-content">
          <div style="display:inline-flex; align-items:center; gap:8px; background:rgba(244,63,94,0.1); border:1px solid rgba(244,63,94,0.2); border-radius:99px; padding:6px 16px; font-size:12px; font-weight:800; letter-spacing:1px; color:var(--accent); text-transform:uppercase; margin-bottom:24px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg> Cardi AI Agent
          </div>

          <h1>{t('agent.heroTitle')}</h1>
          <p>{t('agent.heroSub')}</p>

          <div style="display:flex; gap:16px; flex-wrap:wrap;">
            <a href="#fitur" class="btn" style="gap:10px;">{t('agent.ctaIntelligence')}</a>
            <a href="https://api.whatsapp.com/send?phone=6281289895646&text=Hello%20Cardi%20Agent!!%20I%20would%20like%20to%20try%20the%20free%20trial.%20%F0%9F%98%81%F0%9F%98%81" target="_blank" class="btn ghost">{t('agent.ctaTrial')}</a>
          </div>

          <div style="display:flex; gap:32px; margin-top:48px; flex-wrap:wrap; border-top: 1px solid var(--border); padding-top: 32px;">
            <div>
              <div style="font-size:32px; font-weight:800; color:var(--text-dark); letter-spacing:-1px;">{t('agent.stat1Num')}</div>
              <div style="font-size:13px; color:var(--text-gray); font-weight:600;">{t('agent.stat1Label')}</div>
            </div>
            <div style="width:1px; background:var(--border);"></div>
            <div>
              <div style="font-size:32px; font-weight:800; color:var(--text-dark); letter-spacing:-1px;">{t('agent.stat2Num')}</div>
              <div style="font-size:13px; color:var(--text-gray); font-weight:600;">{t('agent.stat2Label')}</div>
            </div>
          </div>
        </div>

        <!-- SIMULATOR CHATBOT -->
        <div>
          <div class="simulator-scenarios">
            <button class="scenario-btn active" id="btn-kopi" data-scenario="kopi">{t('agent.simCat1')}</button>
            <button class="scenario-btn" id="btn-hijab" data-scenario="fashion">{t('agent.simCat2')}</button>
            <button class="scenario-btn" id="btn-web" data-scenario="agency">{t('agent.simCat3')}</button>
          </div>

          <div class="ui-mockup-container">
            <div class="chat-header">
              <div class="chat-avatar" id="sim-avatar">☕</div>
              <div>
                <div class="chat-name" id="sim-name">Kopi Premium</div>
                <div class="chat-status">{t('agent.simStatus')}</div>
              </div>
            </div>

            <div class="chat-body" id="sim-chat-body">
              <div class="chat-bubble in" id="sim-initial-bubble">{t('agent.simIn1')}</div>
            </div>

            <div class="quick-replies" id="sim-quick-replies">
              <button class="quick-btn" data-text={t('agent.simQuick1')}>{t('agent.simQuick1')}</button>
              <button class="quick-btn" data-text={t('agent.simQuick2')}>{t('agent.simQuick2')}</button>
            </div>

            <div class="chat-footer">
              <form id="sim-form">
                <input type="text" id="sim-input" placeholder={t('agent.simPlaceholder')} autocomplete="off" />
                <button type="submit">&rarr;</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPARISON -->
  <section style="background: var(--bg-gray);">
    <div class="wrap">
      <div class="center">
        <div class="eyebrow">{t('agent.matrixEyebrow')}</div>
        <h2 class="h2">{t('agent.matrixTitle')}</h2>
        <p class="sub">{t('agent.matrixSub')}</p>
      </div>

      <div class="compare-grid">
        <div class="compare-card bad">
          <div class="compare-header" style="color: #EF4444;">
            <div class="compare-icon icon-x">X</div> {t('agent.manualHeader')}
          </div>
          <ul class="compare-list">
            <li><div class="compare-icon icon-x">X</div> {t('agent.manual1')}</li>
            <li><div class="compare-icon icon-x">X</div> {t('agent.manual2')}</li>
            <li><div class="compare-icon icon-x">X</div> {t('agent.manual3')}</li>
          </ul>
        </div>

        <div class="compare-card good">
          <div class="compare-header" style="color: var(--primary);">
            <div class="compare-icon icon-v">✓</div> {t('agent.aiHeader')}
          </div>
          <ul class="compare-list">
            <li><div class="compare-icon icon-v">✓</div> {t('agent.ai1')}</li>
            <li><div class="compare-icon icon-v">✓</div> {t('agent.ai2')}</li>
            <li><div class="compare-icon icon-v">✓</div> {t('agent.ai3')}</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- BENTO FEATURES -->
  <section id="fitur">
    <div class="wrap">
      <div class="center">
        <div class="eyebrow">{t('agent.bentoEyebrow')}</div>
        <h2 class="h2">{t('agent.bentoTitle')}</h2>
        <p class="sub">{t('agent.bentoSub')}</p>
      </div>

      <div class="bento-grid">
        <div class="bento-card bento-large">
          <div class="bento-icon">🧠</div>
          <h3>{t('agent.b1Title')}</h3>
          <p>{t('agent.b1Desc')}</p>
        </div>
        <div class="bento-card">
          <div class="bento-icon">⚡</div>
          <h3>{t('agent.b2Title')}</h3>
          <p>{t('agent.b2Desc')}</p>
        </div>
        <div class="bento-card">
          <div class="bento-icon">📦</div>
          <h3>{t('agent.b3Title')}</h3>
          <p>{t('agent.b3Desc')}</p>
        </div>
        <div class="bento-card bento-large">
          <div class="bento-icon">📈</div>
          <h3>{t('agent.b4Title')}</h3>
          <p>{t('agent.b4Desc')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ROI CALCULATOR -->
  <section style="background: var(--bg-gray);" id="kalkulator">
    <div class="wrap">
      <div class="roi-grid">
        <div class="roi-calculator">
          <h2 style="font-size: 28px; font-weight: 800; margin-bottom: 12px; color: var(--text-dark);">{t('agent.roiTitle')}</h2>
          <p style="color: var(--text-gray); margin-bottom: 32px; font-size: 14.5px; line-height: 1.6;">{t('agent.roiSub')}</p>
          <div class="roi-slider-group">
            <label>
