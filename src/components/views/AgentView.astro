  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Calculator logic
      const slider = document.getElementById('chatSlider') as HTMLInputElement;
      const valChats = document.getElementById('val-chats');
      const resGaji = document.getElementById('res-gaji');
      const resWaktu = document.getElementById('res-waktu');
      const costManual = document.getElementById('chart-cost-manual');
      const barManual = document.getElementById('chart-bar-manual');

      function updateCalc() {
        if (!slider) return;
        const chats = parseInt(slider.value, 10);
        if (valChats) valChats.textContent = `${chats} Chat / Hari`;
        const gaji = Math.round((chats / 150) * 2400000);
        const waktu = Math.round((chats / 150) * 150);

        if (resGaji) resGaji.textContent = `Rp ${gaji.toLocaleString('id-ID')}`;
        if (resWaktu) resWaktu.textContent = `${waktu} Jam`;
        if (costManual) costManual.textContent = `Rp ${gaji.toLocaleString('id-ID')}`;
        if (barManual) {
          const pct = Math.min(100, Math.max(20, (gaji / 8000000) * 100));
          barManual.style.width = `${pct}%`;
        }
      }

      if (slider) {
        slider.addEventListener('input', updateCalc);
        updateCalc();
      }

      // 2. Interactive Chat Simulator Logic
      const heroSec = document.querySelector('.hero[data-lang]');
      const currentLang = heroSec ? heroSec.getAttribute('data-lang') || 'id' : 'id';

      const simAvatar = document.getElementById('sim-avatar');
      const simName = document.getElementById('sim-name');
      const simChatBody = document.getElementById('sim-chat-body');
      const simQuickReplies = document.getElementById('sim-quick-replies');
      const simForm = document.getElementById('sim-form') as HTMLFormElement;
      const simInput = document.getElementById('sim-input') as HTMLInputElement;

      const scenarios: Record<string, {
        avatar: string;
        name: string;
        greeting: Record<string, string>;
        quicks: Record<string, string[]>;
        responses: Record<string, Record<string, string>>;
        defaultResponse: Record<string, string>;
      }> = {
        kopi: {
          avatar: '☕',
          name: 'Kopi Premium',
          greeting: {
            id: 'Halo kak! Selamat datang di Kopi Premium. Ada yang bisa saya bantu hari ini?',
            en: 'Hello! Welcome to Premium Coffee. How can I help you today?',
            zh: '您好！欢迎光临精品咖啡。今天有什么可以帮您？'
          },
          quicks: {
            id: ['Lihat menu favorit', 'Pesan via WhatsApp', 'Lokasi outlet'],
            en: ['View popular menu', 'Order via WhatsApp', 'Store location'],
            zh: ['查看热门菜单', '通过 WhatsApp 下单', '门店位置']
          },
          responses: {
            'menu': {
              id: 'Menu favorit kami minggu ini: ☕ Aren Latte (28k), 🥛 Oat Milk Creamy (32k), & 🥐 Butter Croissant (22k). Mau coba yang mana kak?',
              en: 'Our top picks this week: ☕ Aren Latte ($2.5), 🥛 Oat Milk Creamy ($3.0), & 🥐 Butter Croissant ($2.0). Which one would you like to try?',
              zh: '本周招牌推荐：☕ 棕榈糖拿铁, 🥛 燕麦奶拿铁, & 🥐 牛角面包。您想品尝哪款？'
            },
            'whatsapp': {
              id: 'Siap kak! Silakan klik link WhatsApp di bawah untuk langsung terhubung dengan tim kasir kami. 🛒✨',
              en: 'Certainly! Click the WhatsApp button below to instantly connect with our team. 🛒✨',
              zh: '好的！点击下方 WhatsApp 链接即可直接与我们的客服对接。🛒✨'
            },
            'lokasi': {
              id: 'Outlet kami berlokasi di Senopati Jakarta Selatan dan BSD Tangerang. Buka dari jam 07:00 - 22:00 WIB!',
              en: 'Our stores are located at Senopati South Jakarta and BSD Tangerang. Open daily 07:00 - 22:00!',
              zh: '门店位于雅加达 Senopati 及 BSD Tangerang。每日营业时间 07:00 - 22:00！'
            }
          },
          defaultResponse: {
            id: 'Tentu kak! Pesanan Anda telah dicatat oleh AI. Ada pesanan tambahan lainnya?',
            en: 'Certainly! Your request has been processed by AI. Anything else I can assist with?',
            zh: '好的！您的需求已由 AI 成功记录。还需要其他帮助吗？'
          }
        },
        fashion: {
          avatar: '👗',
          name: 'Hijab Chic',
          greeting: {
            id: 'Halo Sis! Selamat datang di Hijab Chic. Lagi cari gamis, pashmina, atau promo spesial hari ini?',
            en: 'Hello Sis! Welcome to Hijab Chic. Looking for dresses, scarves, or today\'s special deal?',
            zh: '您好！欢迎光临 Hijab Chic。今天想看连身裙、围巾还是特别优惠？'
          },
          quicks: {
            id: ['Katalog warna terbaru', 'Cek ongkir ke Jakarta', 'Diskon 50%'],
            en: ['New color catalog', 'Check shipping rate', '50% Discount'],
            zh: ['最新配色图册', '查询运费', '五折优惠']
          },
          responses: {
            'katalog': {
              id: 'Koleksi Earth Tone terbaru kami ready stock! 🌸 Seri Rose Gold dan Sage Green paling laris minggu ini.',
              en: 'Our new Earth Tone collection is in stock! 🌸 Rose Gold and Sage Green are this week\'s bestsellers.',
              zh: '全新大地色系现货供应！🌸 玫瑰金与鼠尾草绿是本周热销款式。'
            },
            'ongkir': {
              id: 'Ongkir promo hari ini flat Rp 9.000 ke seluruh Jabodetabek + Bebas Ongkir minimum belanja 150k! 🚚',
              en: 'Flat shipping promo today + Free shipping on orders over $15! 🚚',
              zh: '今日特惠运费 + 满额包邮优惠！🚚'
            },
            'diskon': {
              id: 'Gunakan kode promo "CARDI50" saat checkout untuk diskon 50% produk pilihan!',
              en: 'Use promo code "CARDI50" at checkout for 50% off selected items!',
              zh: '结账时使用优惠码 "CARDI50" 即可享受指定商品五折优惠！'
            }
          },
          defaultResponse: {
            id: 'Siap sis! Produk favoritmu sudah tersimpan di keranjang. Mau langsung checkout?',
            en: 'Great! Your selected items are saved in the cart. Ready to checkout?',
            zh: '好的！您选中的商品已保存至购物车。要直接结算吗？'
          }
        },
        agency: {
          avatar: '💻',
          name: 'Digital Studio',
          greeting: {
            id: 'Halo! Selamat datang di Digital Studio. Apakah Anda ingin konsultasi pembuatan website, branding, atau SEO?',
            en: 'Hello! Welcome to Digital Studio. Are you interested in web development, branding, or SEO consulting?',
            zh: '您好！欢迎咨询 Digital Studio。您想了解网站开发、品牌设计还是 SEO 服务？'
          },
          quicks: {
            id: ['Portofolio proyek', 'Pricelist pembuatan web', 'Jadwal meeting'],
            en: ['Project portfolio', 'Web development pricing', 'Schedule meeting'],
            zh: ['项目案例库', '网站开发报价', '预约会议']
          },
          responses: {
            'portofolio': {
              id: 'Kami telah menyelesaikan 50+ proyek web & branding untuk brand nasional dan internasional. Cek karya terbaru di cardi.co.id!',
              en: 'We have delivered 50+ web & branding projects for global brands. Check out our portfolio at cardi.co.id!',
              zh: '我们已为多家国际知名品牌交付 50+ 网站与品牌设计项目。欢迎访问 cardi.co.id 查看最新案例！'
            },
            'pricelist': {
              id: 'Paket Web Professional mulai Rp 4.900.000 (sudah termasuk domain, SSL, SEO setup & AI chatbot integrasi).',
              en: 'Professional Web Package starts at $350 (includes domain, SSL, SEO setup & AI chatbot integration).',
              zh: '专业版网站建设套餐 350 美金起（含域名、SSL 证书、SEO 优化及 AI 智能客服集成）。'
            },
            'jadwal': {
              id: 'Silakan pilih jadwal consultation call 30 menit gratis dengan Lead Developer kami!',
              en: 'Please select a slot for a free 30-minute consultation call with our Lead Developer!',
              zh: '请选择时间预约与我们首席工程师进行 30 分钟免费一对一咨询！'
            }
          },
          defaultResponse: {
            id: 'Terima kasih atas pesannya! Tim spesialis kami akan segera membalas detail proyek Anda dalam hitungan menit.',
            en: 'Thank you for your message! Our specialist team will respond with project details in minutes.',
            zh: '感谢您的留言！我们的专家团队将在数分钟内回复您有关项目的详细方案。'
          }
        }
      };

      let currentScenarioKey = 'kopi';

      function appendMessage(sender: 'in' | 'out', text: string) {
        if (!simChatBody) return;
        const bubble = document.createElement('div');
        bubble.className = `chat-bubble ${sender}`;
        bubble.textContent = text;
        simChatBody.appendChild(bubble);
        simChatBody.scrollTop = simChatBody.scrollHeight;
      }

      function showTypingIndicator() {
        if (!simChatBody) return null;
        const bubble = document.createElement('div');
        bubble.className = 'chat-bubble in';
        bubble.id = 'sim-typing';
        bubble.innerHTML = '<div class="typing-dots"><span></span><span></span><span></span></div>';
        simChatBody.appendChild(bubble);
        simChatBody.scrollTop = simChatBody.scrollHeight;
        return bubble;
      }

      function removeTypingIndicator() {
        const typing = document.getElementById('sim-typing');
        if (typing) typing.remove();
      }

      function handleUserSend(text: string) {
        if (!text.trim()) return;
        appendMessage('out', text);

        showTypingIndicator();

        setTimeout(() => {
          removeTypingIndicator();
          const scenario = scenarios[currentScenarioKey];
          let replyText = '';

          const lower = text.toLowerCase();
          if (lower.includes('menu') || lower.includes('katalog') || lower.includes('portofolio') || lower.includes('favorite') || lower.includes('菜单') || lower.includes('catalog') || lower.includes('portfolio')) {
            const respObj = scenario.responses['menu'] || scenario.responses['katalog'] || scenario.responses['portofolio'];
            replyText = respObj[currentLang] || respObj['id'];
          } else if (lower.includes('whatsapp') || lower.includes('ongkir') || lower.includes('pricelist') || lower.includes('shipping') || lower.includes('运费') || lower.includes('pricing') || lower.includes('rate')) {
            const respObj = scenario.responses['whatsapp'] || scenario.responses['ongkir'] || scenario.responses['pricelist'];
            replyText = respObj[currentLang] || respObj['id'];
          } else if (lower.includes('lokasi') || lower.includes('diskon') || lower.includes('jadwal') || lower.includes('discount') || lower.includes('location') || lower.includes('meeting') || lower.includes('schedule') || lower.includes('位置')) {
            const respObj = scenario.responses['lokasi'] || scenario.responses['diskon'] || scenario.responses['jadwal'];
            replyText = respObj[currentLang] || respObj['id'];
          } else {
            replyText = scenario.defaultResponse[currentLang] || scenario.defaultResponse['id'];
          }

          appendMessage('in', replyText);
        }, 700);
      }

      function renderScenario(key: string) {
        currentScenarioKey = key;
        const sc = scenarios[key];
        if (!sc) return;

        if (simAvatar) simAvatar.textContent = sc.avatar;
        if (simName) simName.textContent = sc.name;

        if (simChatBody) {
          simChatBody.innerHTML = '';
          const greeting = sc.greeting[currentLang] || sc.greeting['id'];
          appendMessage('in', greeting);
        }

        if (simQuickReplies) {
          simQuickReplies.innerHTML = '';
          const quickList = sc.quicks[currentLang] || sc.quicks['id'];
          quickList.forEach(qText => {
            const btn = document.createElement('button');
            btn.className = 'quick-btn';
            btn.type = 'button';
            btn.textContent = qText;
            btn.addEventListener('click', () => {
              handleUserSend(qText);
            });
            simQuickReplies.appendChild(btn);
          });
        }
      }

      // Scenario Buttons Switcher
      const scenarioBtns = document.querySelectorAll('.scenario-btn');
      scenarioBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          scenarioBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const scenarioKey = btn.getAttribute('data-scenario') || 'kopi';
          renderScenario(scenarioKey);
        });
      });

      // Form Submit
      if (simForm && simInput) {
        simForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const val = simInput.value;
          if (val) {
            handleUserSend(val);
            simInput.value = '';
          }
        });
      }

      // Initial scenario render
      renderScenario('kopi');
    });
  </script>
