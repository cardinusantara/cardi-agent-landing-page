---
// ConsultModal.astro
---
<div class="modal-overlay" id="consultModal">
  <div class="modal-content">
    <button class="modal-close" id="closeModal">&times;</button>
    <div style="text-align: left; margin-bottom: 24px;">
      <h3 style="font-size: 22px; font-weight: 800; color: var(--ink); margin-bottom: 6px;">Jadwalkan Konsultasi</h3>
      <p style="font-size: 13.5px; color: var(--muted); line-height: 1.5;">Isi formulir singkat di bawah ini. Tim pakar kami akan menghubungi Anda via WhatsApp dalam waktu kurang dari 15 menit.</p>
    </div>
    <form id="consultForm">
      <div class="form-group">
        <label for="nama">Nama Lengkap</label>
        <input type="text" id="nama" class="form-control" placeholder="Contoh: Budi Santoso" required />
      </div>
      <div class="form-group">
        <label for="perusahaan">Nama Bisnis / Brand</label>
        <input type="text" id="perusahaan" class="form-control" placeholder="Contoh: Kopi Nusantara" required />
      </div>
      <div class="form-group">
        <label for="whatsapp">Nomor WhatsApp</label>
        <input type="tel" id="whatsapp" class="form-control" placeholder="081234567890" required />
      </div>
      <div class="form-group">
        <label for="kebutuhan">Kebutuhan Utama</label>
        <select id="kebutuhan" class="form-control" style="cursor: pointer;">
          <option value="Cardi Agent (AI Chatbot &amp; CRM)">Cardi Agent (AI Chatbot &amp; CRM WhatsApp)</option>
          <option value="Cardi Nusantara (Distribusi Retail)">Cardi Nusantara (Distribusi Retail Nasional)</option>
          <option value="Cardi Digital (Digital Growth)">Cardi Digital (Digital Growth &amp; Performance)</option>
          <option value="Cardi Branding (Brand Development)">Cardi Branding (Brand Development &amp; Visual)</option>
          <option value="Ekosistem Lengkap (All-in-One)">Ekosistem Lengkap (All-in-One Growth)</option>
        </select>
      </div>
      <button type="submit" class="form-submit">Kirim via WhatsApp &rarr;</button>
    </form>
  </div>
</div>

<script>
  const consultModal = document.getElementById('consultModal');
  const closeModal = document.getElementById('closeModal');
  const consultForm = document.getElementById('consultForm');

  function openModal() {
    if (consultModal) consultModal.classList.add('active');
  }

  function hideModal() {
    if (consultModal) consultModal.classList.remove('active');
  }

  if (closeModal) {
    closeModal.addEventListener('click', hideModal);
  }

  if (consultModal) {
    consultModal.addEventListener('click', (e) => {
      if (e.target === consultModal) hideModal();
    });
  }

  if (consultForm) {
    consultForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const nama = (document.getElementById('nama') as HTMLInputElement)?.value || '';
      const perusahaan = (document.getElementById('perusahaan') as HTMLInputElement)?.value || '';
      const whatsapp = (document.getElementById('whatsapp') as HTMLInputElement)?.value || '';
      const kebutuhan = (document.getElementById('kebutuhan') as HTMLSelectElement)?.value || '';

      const text = `Halo Tim Cardi Nusantara,%0A%0ASaya ingin menjadwalkan konsultasi bisnis:%0A- *Nama*: ${encodeURIComponent(nama)}%0A- *Bisnis/Brand*: ${encodeURIComponent(perusahaan)}%0A- *No. WA*: ${encodeURIComponent(whatsapp)}%0A- *Kebutuhan*: ${encodeURIComponent(kebutuhan)}%0A%0AMohon dihubungi kembali. Terima kasih!`;
      window.open(`https://api.whatsapp.com/send?phone=6281289895646&text=${text}`, '_blank');
      hideModal();
    });
  }
</script>
