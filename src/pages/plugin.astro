---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ConsultModal from '../components/ConsultModal.astro';
import PurchaseNotif from '../components/PurchaseNotif.astro';
---

<Layout title="Optima SEO by Cardi — Plugin SEO WordPress Otomatis Terbaik 2026" description="Dominasi halaman pertama Google dengan plugin SEO WordPress terlengkap. Otomatisasi meta tag, internal linking, schema markup, dan optimasi konten AI secara autopilot.">
  <Navbar />

  <!-- PLUGIN HERO -->
  <section class="hero" style="text-align: center; padding: 80px 0 40px;">
    <div class="wrap">
      <div style="display:inline-flex; align-items:center; gap:8px; background:rgba(0,168,126,0.1); border:1px solid rgba(0,168,126,0.2); border-radius:99px; padding:6px 16px; font-size:12px; font-weight:800; letter-spacing:1px; color:#00A87E; text-transform:uppercase; margin-bottom:24px;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg> Optima SEO Plugin
      </div>
      <h1 style="font-size: clamp(32px, 5vw, 54px); font-weight: 800; line-height: 1.15; letter-spacing: -1.5px; color: var(--ink); max-width: 840px; margin: 0 auto 20px;">
        Dominasi Peringkat 1 Google Tanpa Ribet Optimasi Manual.
      </h1>
      <p style="font-size: 17px; color: var(--body); line-height: 1.65; max-width: 640px; margin: 0 auto 32px;">
        Plugin SEO WordPress autopilot yang mengotomatisasi meta title, meta description, internal linking, schema markup, hingga pemantauan peringkat keyword secara real-time.
      </p>
      <div style="display:flex; gap:16px; justify-content:center; flex-wrap:wrap;">
        <a href="https://api.whatsapp.com/send?phone=6281289895646&text=Hello%20Cardi!!%20I%20would%20like%20to%20get%20Optima%20SEO%20Plugin.%20%F0%9F%98%81%F0%9F%98%81" target="_blank" class="btn" style="background:#00A87E;">Dapatkan Optima Plugin &rarr;</a>
        <a href="#fitur" class="btn ghost">Lihat Fitur Lengkap</a>
      </div>
    </div>
  </section>

  <!-- FEATURES GRID -->
  <section id="fitur" style="background: var(--soft);">
    <div class="wrap">
      <div class="center">
        <div class="eyebrow" style="color:#00A87E;">FITUR AUTOPILOT</div>
        <h2 class="h2">Optimasi Otomatis untuk Semua Halaman</h2>
        <p class="sub">Tinggalkan cara konvensional yang menyita waktu jam kerja tim Anda.</p>
      </div>

      <div class="prodGrid" style="margin-top:44px;">
        <div class="scard">
          <div class="ic" style="background:#E3F6EF;"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#00A87E" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg></div>
          <h3>Meta Title &amp; Description Generator</h3>
          <p>Membuat judul dan meta deskripsi yang memikat calon pengunjung otomatis berbasis kata kunci turunan relevan.</p>
        </div>
        <div class="scard">
          <div class="ic" style="background:#E3F6EF;"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#00A87E" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg></div>
          <h3>Smart Internal Linking Engine</h3>
          <p>Menghubungkan artikel dan landing page secara cerdas untuk memperkuat struktur otoritas domain di mata algoritma Google.</p>
        </div>
        <div class="scard">
          <div class="ic" style="background:#E3F6EF;"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#00A87E" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg></div>
          <h3>Schema Markup &amp; Rich Snippets</h3>
          <p>Otomatisasi JSON-LD Schema (Article, FAQ, Product, Business) agar tampilan pencarian Anda kaya akan bintang ulasan dan cuplikan menarik.</p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
  <ConsultModal />
  <PurchaseNotif />
</Layout>
