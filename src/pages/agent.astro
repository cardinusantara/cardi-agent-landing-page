---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ConsultModal from '../components/ConsultModal.astro';
import PurchaseNotif from '../components/PurchaseNotif.astro';
---

<Layout title="Cardi AI Agent - Scale to IPO - AI Agents for Business Growth & IPO Readiness">
  <Navbar />

  <!-- AGENT STYLES -->
  <style>
    :root {
      --bg-light: #FAFCFF;
      --bg-gray: #F4F6FB;
      --text-dark: #0F172A;
      --text-gray: #475569;
      --border: #E2E8F0;
      --primary: #1E4FFF;
      --accent: #F43F5E;
    }
    .hero {
      padding: 80px 0 60px;
      text-align: left;
      background: radial-gradient(800px 400px at 20% 0%, rgba(30,79,255,0.06), transparent 70%);
    }
    .hero-wrap {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      align-items: center;
    }
    @media(max-width: 900px) {
      .hero-wrap {
        grid-template-columns: 1fr;
      }
    }
    .hero-content h1 {
      font-size: clamp(32px, 4vw, 52px);
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -1.5px;
      color: var(--text-dark);
      margin-bottom: 20px;
    }
    .hero-content p {
      font-size: 17px;
      color: var(--text-gray);
      line-height: 1.65;
      margin-bottom: 32px;
    }
    .simulator-scenarios {
      display: flex;
      gap: 10px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }
    .scenario-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      border-radius: 99px;
      border: 1px solid var(--border);
      background: #fff;
      font-size: 13px;
      font-weight: 700;
      color: var(--text-gray);
      cursor: pointer;
      transition: 0.2s;
    }
    .scenario-btn.active, .scenario-btn:hover {
      border-color: var(--primary);
      color: var(--primary);
      background: #EEF3FF;
    }
    .ui-mockup-container {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 24px;
      box-shadow: 0 20px 40px -15px rgba(15,23,42,0.1);
      overflow: hidden;
    }
    .chat-header {
      padding: 14px 20px;
      background: var(--bg-gray);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .chat-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--primary);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .chat-name {
      font-weight: 800;
      font-size: 14px;
      color: var(--text-dark);
    }
    .chat-status {
      font-size: 11px;
      color: #10B981;
      font-weight: 600;
    }
    .chat-body {
      padding: 20px;
      height: 320px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 12px;
      background: #FAFCFF;
    }
    .chat-bubble {
      max-width: 80%;
      padding: 10px 14px;
      border-radius: 14px;
      font-size: 13px;
      line-height: 1.5;
    }
    .chat-bubble.in {
      background: #fff;
      border: 1px solid var(--border);
      align-self: flex-start;
      border-bottom-left-radius: 4px;
      color: var(--text-dark);
    }
    .chat-bubble.out {
      background: var(--primary);
      color: #fff;
      align-self: flex-end;
      border-bottom-right-radius: 4px;
    }
    .quick-replies {
      padding: 10px 20px;
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      background: #fff;
      border-top: 1px solid var(--border);
    }
    .quick-btn {
      padding: 6px 12px;
      border-radius: 99px;
      border: 1px solid var(--border);
      background: var(--bg-gray);
      font-size: 12px;
      font-weight: 600;
      color: var(--text-dark);
      cursor: pointer;
      transition: 0.2s;
    }
    .quick-btn:hover {
      border-color: var(--primary);
      color: var(--primary);
    }
    .chat-footer {
      padding: 12px 20px;
      background: #fff;
      border-top: 1px solid var(--border);
    }
    .chat-footer form {
      display: flex;
      gap: 8px;
    }
    .chat-footer input {
      flex: 1;
      padding: 10px 14px;
      border-radius: 10px;
      border: 1px solid var(--border);
      outline: none;
      font-size: 13px;
    }
    .chat-footer button {
      padding: 10px 16px;
      border-radius: 10px;
      background: var(--primary);
      color: #fff;
      border: none;
      cursor: pointer;
    }
    .compare-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin-top: 40px;
    }
    @media(max-width: 768px) {
      .compare-grid { grid-template-columns: 1fr; }
    }
    .compare-card {
      padding: 32px;
      border-radius: 20px;
      border: 1px solid var(--border);
      background: #fff;
    }
    .compare-card.bad { border-color: #FCA5A5; background: #FFF5F5; }
    .compare-card.good { border-color: #93C5FD; background: #F0F7FF; }
    .compare-header {
      font-size: 18px;
      font-weight: 800;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .compare-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .compare-list li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 14px;
      color: var(--text-dark);
      line-height: 1.5;
    }
    .compare-icon {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      font-weight: 800;
      flex-shrink: 0;
    }
    .icon-x { background: #EF4444; color: #fff; }
    .icon-v { background: #10B981; color: #fff; }

    /* Bento Features */
    .bento-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-top: 40px;
    }
    @media(max-width: 900px) {
      .bento-grid { grid-template-columns: 1fr; }
    }
    .bento-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 28px;
      transition: 0.25s;
    }
    .bento-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 32px -12px rgba(15,23,42,0.1);
    }
    .bento-large { grid-column: span 2; }
    @media(max-width: 900px) { .bento-large { grid-column: span 1; } }
    .bento-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: #EEF3FF;
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
    }
    .bento-card h3 {
      font-size: 18px;
      font-weight: 800;
      margin-bottom: 10px;
      color: var(--text-dark);
    }
    .bento-card p {
      font-size: 14px;
      color: var(--text-gray);
      line-height: 1.6;
    }

    /* ROI Calc */
    .roi-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      align-items: center;
    }
    @media(max-width: 900px) { .roi-grid { grid-template-columns: 1fr; } }
    .roi-calculator {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 36px;
    }
    .roi-slider-group {
      margin-bottom: 32px;
    }
    .roi-slider-group label {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-weight: 700;
      font-size: 14px;
      margin-bottom: 12px;
    }
    .roi-val-badge {
      background: #EEF3FF;
      color: var(--primary);
      padding: 4px 12px;
      border-radius: 99px;
      font-size: 12px;
    }
    .roi-slider-group input[type="range"] {
      width: 100%;
      accent-color: var(--primary);
    }
    .roi-result-card {
      background: var(--bg-gray);
      padding: 16px;
      border-radius: 12px;
    }
    .roi-result-label {
      font-size: 12px;
      font-weight: 700;
      color: var(--text-gray);
      margin-bottom: 4px;
    }
    .roi-result-value {
      font-size: 24px;
      font-weight: 800;
      color: var(--text-dark);
    }
    .roi-result-value.blue { color: var(--primary); }

    .roi-chart-board {
      background: var(--text-dark);
      color: #fff;
      border-radius: 20px;
      padding: 36px;
    }
    .chart-header h4 { font-size: 18px; font-weight: 800; margin-bottom: 6px; }
    .chart-header p { font-size: 13px; color: #94A3B8; margin-bottom: 24px; }
    .chart-bar-group { margin-bottom: 20px; }
    .chart-label { display: flex; justify-content: space-between; font-size: 13px; font-weight: 700; margin-bottom: 8px; }
    .bar-track { height: 12px; background: rgba(255,255,255,0.1); border-radius: 99px; overflow: hidden; }
    .bar-fill { height: 100%; border-radius: 99px; transition: width 0.3s ease; }
    .bar-fill.bad { background: #EF4444; }
    .bar-fill.good { background: #10B981; width: 100%; }
    .chart-summary {
      margin-top: 24px;
      padding-top: 16px;
      border-top: 1px solid rgba(255,255,255,0.1);
      display: flex;
      gap: 12px;
      font-size: 12.5px;
      color: #CBD5E1;
      line-height: 1.5;
    }

    /* Pricing Section */
    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-top: 44px;
    }
    @media(max-width: 900px) { .pricing-grid { grid-template-columns: 1fr; } }
    .pricing-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 36px 28px;
      display: flex;
      flex-direction: column;
    }
    .pricing-card.premium {
      border-color: var(--primary);
      box-shadow: 0 16px 40px -10px rgba(30,79,255,0.15);
      position: relative;
    }
    .pricing-tier { font-size: 13px; font-weight: 800; letter-spacing: 1px; color: var(--primary); text-transform: uppercase; margin-bottom: 12px; }
    .pricing-price { font-size: 38px; font-weight: 800; color: var(--text-dark); margin-bottom: 12px; display: flex; align-items: baseline; gap: 4px; }
    .pricing-desc { font-size: 14px; color: var(--text-gray); line-height: 1.6; margin-bottom: 24px; }
    .pricing-features-list { list-style: none; display: flex; flex-direction: column; gap: 12px; margin-bottom: 32px; flex: 1; }
    .pricing-features-list li { display: flex; align-items: center; gap: 10px; font-size: 13.5px; color: var(--text-dark); }
    .pricing-btn { width: 100%; justify-content: center; text-align: center; }
  </style>

  <!-- HERO SECTION -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-wrap">
        <div class="hero-content">
          <div style="display:inline-flex; align-items:center; gap:8px; background:rgba(244,63,94,0.1); border:1px solid rgba(244,63,94,0.2); border-radius:99px; padding:6px 16px; font-size:12px; font-weight:800; letter-spacing:1px; color:var(--accent); text-transform:uppercase; margin-bottom:24px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg> Cardi AI Agent
          </div>

          <h1>Scale to IPO. AI Agents for Business Growth &amp; IPO Readiness.</h1>
          <p>Berhenti membiarkan leads mendingin dan laporan operasional berantakan. Cardi AI Agent mengambil alih operasional dan penjualan Anda—membalas dalam 2 detik, memproses pesanan 24/7, serta merapikan data transaksi real-time agar bisnis Anda siap scale-up menuju IPO.</p>

          <div style="display:flex; gap:16px; flex-wrap:wrap;">
            <a href="#fitur" class="btn" style="gap:10px;">Lihat Kecerdasan AI &rarr;</a>
            <a href="https://api.whatsapp.com/send?phone=6281289895646&text=Hello%20Cardi%20Agent!!%20I%20would%20like%20to%20try%20the%20free%20trial.%20%F0%9F%98%81%F0%9F%98%81" target="_blank" class="btn ghost">Uji Coba Gratis</a>
          </div>

          <div style="display:flex; gap:32px; margin-top:48px; flex-wrap:wrap; border-top: 1px solid var(--border); padding-top: 32px;">
            <div>
              <div style="font-size:32px; font-weight:800; color:var(--text-dark); letter-spacing:-1px;">1.8s</div>
              <div style="font-size:13px; color:var(--text-gray); font-weight:600;">Respon rata-rata</div>
            </div>
            <div style="width:1px; background:var(--border);"></div>
            <div>
              <div style="font-size:32px; font-weight:800; color:var(--text-dark); letter-spacing:-1px;">+58%</div>
              <div style="font-size:13px; color:var(--text-gray); font-weight:600;">Lonjakan konversi</div>
            </div>
          </div>
        </div>

        <!-- SIMULATOR CHATBOT -->
        <div>
          <div class="simulator-scenarios">
            <button class="scenario-btn active" id="btn-kopi">Bisnis F&amp;B</button>
            <button class="scenario-btn" id="btn-hijab">Retail &amp; Fashion</button>
            <button class="scenario-btn" id="btn-web">Jasa &amp; Agensi</button>
          </div>

          <div class="ui-mockup-container">
            <div class="chat-header">
              <div class="chat-avatar" id="sim-avatar">☕</div>
              <div>
                <div class="chat-name" id="sim-name">Kopi Premium</div>
                <div class="chat-status">Asisten AI Aktif 24/7</div>
              </div>
            </div>

            <div class="chat-body" id="sim-chat-body">
              <div class="chat-bubble in">Halo kak! Selamat datang di Kopi Premium. Ada yang bisa saya bantu hari ini?</div>
            </div>

            <div class="quick-replies" id="sim-quick-replies">
              <button class="quick-btn" data-text="Lihat menu favorit">Lihat menu favorit</button>
              <button class="quick-btn" data-text="Pesan via WhatsApp">Pesan via WhatsApp</button>
            </div>

            <div class="chat-footer">
              <form id="sim-form">
                <input type="text" id="sim-input" placeholder="Ketik simulasi pesan..." autocomplete="off" />
                <button type="submit">&rarr;</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPARISON -->
  <section style="background: var(--bg-gray);">
    <div class="wrap">
      <div class="center">
        <div class="eyebrow">EFFICIENCY MATRIX</div>
        <h2 class="h2">Cara Lama vs Mesin Konversi Baru</h2>
        <p class="sub">Mengapa mempekerjakan puluhan admin manual tak lagi relevan untuk skala bisnis modern.</p>
      </div>

      <div class="compare-grid">
        <div class="compare-card bad">
          <div class="compare-header" style="color: #EF4444;">
            <div class="compare-icon icon-x">X</div> Metode Manual (Bocor Profit)
          </div>
          <ul class="compare-list">
            <li><div class="compare-icon icon-x">X</div> Respon lambat (3-15 menit). Konsumen tidak sabar dan beralih ke lapak kompetitor.</li>
            <li><div class="compare-icon icon-x">X</div> Biaya operasional membengkak karena harus membayar gaji lembur shift malam.</li>
            <li><div class="compare-icon icon-x">X</div> Follow-up tagihan sering terlewat karena admin kewalahan membalas chat baru.</li>
          </ul>
        </div>

        <div class="compare-card good">
          <div class="compare-header" style="color: var(--primary);">
            <div class="compare-icon icon-v">✓</div> Cardi AI Agent (Mesin Presisi)
          </div>
          <ul class="compare-list">
            <li><div class="compare-icon icon-v">✓</div> Respon instan di bawah 2 detik. Pelanggan terkunci di saat minat mereka sedang tinggi.</li>
            <li><div class="compare-icon icon-v">✓</div> Layanan bintang lima beroperasi 24/7 tanpa henti, tanpa cuti, dan tanpa uang lembur.</li>
            <li><div class="compare-icon icon-v">✓</div> AI melacak prospek hangat dan melakukan follow-up otomatis dengan bahasa elegan.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- BENTO FEATURES -->
  <section id="fitur">
    <div class="wrap">
      <div class="center">
        <div class="eyebrow">FITUR UNGGULAN</div>
        <h2 class="h2">Teknologi Kelas Enterprise, Hadir untuk Anda</h2>
        <p class="sub">Setiap fitur dirancang secara spesifik untuk memahami psikologi penjualan dan otomasi data bisnis.</p>
      </div>

      <div class="bento-grid">
        <div class="bento-card bento-large">
          <div class="bento-icon">🧠</div>
          <h3>AI dengan Kecerdasan Emosional (NLP)</h3>
          <p>Bukan sekadar balas otomatis berbasis keyword kaku. Cardi AI Agent dilatih untuk memahami bahasa gaul, singkatan, hingga mendeteksi keraguan pelanggan. Percakapan mengalir 100% layaknya top sales manusia Anda yang paling ramah.</p>
        </div>
        <div class="bento-card">
          <div class="bento-icon">⚡</div>
          <h3>Sistem Penagihan Presisi</h3>
          <p>Mendeteksi pelanggan yang lupa transfer. AI secara proaktif mengirimkan pengingat elegan tanpa kesan memaksa yang justru merusak brand image.</p>
        </div>
        <div class="bento-card">
          <div class="bento-icon">📦</div>
          <h3>Sinkronisasi Inventaris</h3>
          <p>Terhubung langsung dengan katalog produk Anda. Mampu merekomendasikan produk alternatif secara cerdas ketika varian yang diminta sedang kosong.</p>
        </div>
        <div class="bento-card bento-large">
          <div class="bento-icon">📈</div>
          <h3>Dashboard Intelijen Bisnis via WhatsApp</h3>
          <p>Tidak perlu login ke aplikasi rumit. Dapatkan ringkasan metrik harian—seperti total omzet, chat terbanyak, dan rasio closing—dikirimkan otomatis ke grup internal eksekutif setiap pagi.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ROI CALCULATOR -->
  <section style="background: var(--bg-gray);" id="kalkulator">
    <div class="wrap">
      <div class="roi-grid">
        <div class="roi-calculator">
          <h2 style="font-size: 28px; font-weight: 800; margin-bottom: 12px; color: var(--text-dark);">Ukur Sendiri Ledakan Profit Anda</h2>
          <p style="color: var(--text-gray); margin-bottom: 32px; font-size: 14.5px; line-height: 1.6;">Gunakan kalkulator di bawah ini untuk melihat estimasi penghematan biaya operasional secara langsung jika Anda beralih menggunakan sistem autopilot.</p>
          <div class="roi-slider-group">
            <label>
              <span>Volume Chat / Hari</span>
              <span class="roi-val-badge" id="val-chats">150 Chat / Hari</span>
            </label>
            <input type="range" id="chatSlider" min="50" max="2000" step="50" value="150" />
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div class="roi-result-card">
              <div class="roi-result-label">Anggaran Gaji Terbuang /Bln</div>
              <div class="roi-result-value" style="color: #EF4444;" id="res-gaji">Rp 2.400.000</div>
            </div>
            <div class="roi-result-card">
              <div class="roi-result-label">Waktu Operasional Terbuang</div>
              <div class="roi-result-value blue" id="res-waktu">150 Jam</div>
            </div>
          </div>
        </div>

        <div class="roi-chart-board">
          <div class="chart-header">
            <h4>Perbandingan Biaya Operasional (30 Hari)</h4>
            <p>Simulasi visual perbandingan beban operasional antara penambahan tim manual vs sistem otomatis Cardi AI Agent.</p>
          </div>
          <div class="chart-bar-group">
            <div class="chart-label">
              <span>Metode Manual (Shift Admin)</span>
              <span style="color:#EF4444;" id="chart-cost-manual">Rp 2.400.000</span>
            </div>
            <div class="bar-track">
              <div class="bar-fill bad" id="chart-bar-manual" style="width: 35%;"></div>
            </div>
          </div>
          <div class="chart-bar-group">
            <div class="chart-label">
              <span>Cardi AI Agent (Pro)</span>
              <span style="color:#10B981;">Rp 799.000</span>
            </div>
            <div class="bar-track">
              <div class="bar-fill good"></div>
            </div>
          </div>
          <div class="chart-summary">
            <span>Cegah pemborosan anggaran yang terus membengkak seiring bertambahnya trafik chat bisnis Anda.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section id="harga">
    <div class="wrap">
      <div class="center">
        <div class="eyebrow">PRICING TIERS</div>
        <h2 class="h2">Paket Langganan Cardi AI Agent</h2>
        <p class="sub">Investasi paling rasional untuk mengotomatiskan seluruh alur komunikasi &amp; penjualan bisnis Anda.</p>
      </div>

      <div class="pricing-grid">
        <!-- Starter -->
        <div class="pricing-card">
          <div class="pricing-tier">Starter</div>
          <div class="pricing-price">
            <span style="font-size:20px;">Rp</span>299.000<span style="font-size:14px; font-weight:500; color:var(--text-gray);">/bln</span>
          </div>
          <p class="pricing-desc">Cocok untuk bisnis lokal dan UMKM yang ingin menguji keandalan otomatisasi AI.</p>
          <ul class="pricing-features-list">
            <li>✓ Hingga 1.000 Chat/Bulan</li>
            <li>✓ 1 Ekstensi WhatsApp Business</li>
            <li>✓ Pemahaman Konteks NLP Dasar</li>
