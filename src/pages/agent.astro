  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Calculator logic
      const slider = document.getElementById('chatSlider') as HTMLInputElement;
      const valChats = document.getElementById('val-chats');
      const resGaji = document.getElementById('res-gaji');
      const resWaktu = document.getElementById('res-waktu');
      const costManual = document.getElementById('chart-cost-manual');
      const barManual = document.getElementById('chart-bar-manual');

      function updateCalc() {
        if (!slider) return;
        const chats = parseInt(slider.value, 10);
        if (valChats) valChats.textContent = `${chats} Chat / Hari`;
        const gaji = Math.round((chats / 150) * 2400000);
        const waktu = Math.round((chats / 150) * 150);

        if (resGaji) resGaji.textContent = `Rp ${gaji.toLocaleString('id-ID')}`;
        if (resWaktu) resWaktu.textContent = `${waktu} Jam`;
        if (costManual) costManual.textContent = `Rp ${gaji.toLocaleString('id-ID')}`;
        if (barManual) {
          const pct = Math.min(100, Math.max(20, (gaji / 8000000) * 100));
          barManual.style.width = `${pct}%`;
        }
      }

      if (slider) {
        slider.addEventListener('input', updateCalc);
        updateCalc();
      }
    });
  </script>
